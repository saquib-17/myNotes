# Server Environment Configuration (Stage 1 Foundation)
# Copy this file to .env for local overrides if needed.
# Note: Do not store secrets or real credentials in this file.

# Port for the Express backend server (default: 3000)
PORT=3000

# Node environment (development, test, production)
NODE_ENV=development

# Allowed CORS origin in development (default matches Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Database Connection Configuration (Stage 2)
# Standard PostgreSQL discrete connection settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=mynotes_dev
PGUSER=mynotes_app
PGPASSWORD=your_password_here

# Session Configuration (Stage 3)
# Secret key used to sign HTTP session cookies.
# Must be at least 32 characters long with high entropy.
# Generate locally using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Keep this value strictly private and never commit it to source control.
SESSION_SECRET=your_high_entropy_session_secret_32_chars_or_more
