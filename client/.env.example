# Client Environment Configuration (Stage 1 Foundation)
# Copy this file to .env for local overrides if needed.
# IMPORTANT: All variables prefixed with VITE_ are bundled into public client-side JavaScript.
# NEVER store secrets, private API keys, or database credentials here.

# Vite development server port (default: 5173)
VITE_PORT=5173

# Target backend API URL for the Vite development proxy (default: http://localhost:3000)
VITE_API_PROXY_TARGET=http://localhost:3000
